# Server
PORT=5000

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=<db_user>
DB_PASSWORD=<db_password>
DB_NAME=campus_access_pass

# JWT — must be at least 32 characters, keep secret
JWT_SECRET=<replace_with_a_strong_random_secret_at_least_32_chars>

# CORS — origin of the frontend dev server or production URL
CLIENT_ORIGIN=http://localhost:5173
